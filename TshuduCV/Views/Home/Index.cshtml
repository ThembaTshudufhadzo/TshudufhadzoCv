@model TshuduCV.Models.UserProfile

@{
    ViewData["Title"] = "Full-Stack Mobile & Web Developer Portfolio";
    string myPhoneNumber = "+27660447865";
}

<style>
    :root {
        --navy: #1a2a6c;
        --accent: #3a86ff;
    }

    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .hero {
        background: linear-gradient(135deg, #1a2a6c 0%, #0052D4 100%);
        color: white;
        padding: 50px 0;
        border-bottom: 4px solid var(--accent);
    }

    .card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    }

    .btn-action {
        border-radius: 6px;
        font-weight: 600;
        padding: 10px 20px;
        transition: transform 0.15s ease-in-out;
    }

        .btn-action:hover {
            transform: translateY(-2px);
        }
</style>

<div class="hero text-center">
    <div class="container">
        <h1 class="display-5 fw-bold">@Model.FullName</h1>
        <p class="lead mb-4">@Model.ProfessionalTitle</p>

        <!-- CV Action Buttons -->
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="~/Tshudufhadzo_Themba_CV.pdf" target="_blank" class="btn btn-light btn-lg btn-action shadow-sm">
                <i class="bi bi-eye-fill text-primary me-1"></i> View CV
            </a>

            <a href="~/Tshudufhadzo_Themba_CV.pdf" download="Tshudufhadzo_Themba_CV.pdf" class="btn btn-outline-light btn-lg btn-action shadow-sm">
                <i class="bi bi-download me-1"></i> Download CV
            </a>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <!-- Sidebar Column -->
        <div class="col-lg-4">
            <div class="card p-4 mb-4">
                <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">Quick Contact</h5>

                <a href="mailto:@Model.Email?subject=Developer Inquiry" class="btn btn-primary btn-action w-100 mb-2">
                    <i class="bi bi-envelope-at-fill me-1"></i> Email Me
                </a>

                <a href="sms:@myPhoneNumber?body=Hello Tshudu, I saw your portfolio and would like to connect." class="btn btn-success btn-action w-100 mb-3">
                    <i class="bi bi-chat-left-dots-fill me-1"></i> Send SMS
                </a>

                <p class="small text-muted mb-1"><i class="bi bi-geo-alt-fill me-1"></i> @Model.Address</p>

                <div class="mt-3 text-center border-top pt-3">
                    <a href="@Model.LinkedIn" target="_blank" class="btn btn-outline-dark btn-sm me-2"><i class="bi bi-linkedin"></i> LinkedIn</a>
                    <a href="@Model.GitHub" target="_blank" class="btn btn-outline-dark btn-sm"><i class="bi bi-github"></i> GitHub</a>
                </div>
            </div>

            <div class="card p-4 mb-4">
                <h5 class="fw-bold text-primary mb-2">Certifications &amp; Courses</h5>
                <div class="small text-dark mb-2">
                    <strong>Google AI Essentials Specialization</strong><br />
                    <span class="text-muted">Coursera | ID: 19D8C8391NA6</span>
                </div>
                <div class="small text-dark mb-2">
                    <strong>Quantium Data Analytics Simulation</strong><br />
                    <span class="text-muted">Forage</span>
                </div>
                <div class="small text-dark">
                    <strong>Fidelity Customer Service Simulator</strong><br />
                    <span class="text-muted">Forage</span>
                </div>
            </div>

            <div class="card p-4 mb-4">
                <h5 class="fw-bold text-primary mb-2">Work Experience</h5>
                @foreach (var exp in Model.Experience)
                {
                    <div class="mb-2">
                        <div class="fw-bold text-dark">@exp.Role</div>
                        <div class="text-secondary small">@exp.Company | @exp.Duration</div>
                        <p class="small text-muted mt-1">@exp.Description</p>
                    </div>
                }
            </div>
        </div>

        <!-- Main Body Column -->
        <div class="col-lg-8">
            <div class="card p-4 mb-4">
                <h5 class="fw-bold text-primary">Professional Profile</h5>
                <p class="text-secondary mt-2 mb-0">@Model.AboutMe</p>
            </div>

            <div class="card p-4 mb-4">
                <h5 class="fw-bold text-primary mb-3">Academic &amp; Technical Summary</h5>
                <div class="row">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <h6 class="fw-bold text-dark">Education</h6>
                        <p class="small text-secondary mb-1">@Model.Education</p>
                        <p class="small text-muted">Matric: St Augustine Residential School (2018)</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-dark">Technical Competencies</h6>
                        <p class="small text-secondary mb-0">@Model.Skills</p>
                    </div>
                </div>
            </div>

            <div class="card p-4">
                <h5 class="fw-bold text-primary mb-3">Key Technical Projects</h5>
                <div class="row g-3">
                    @foreach (var proj in Model.Projects)
                    {
                        <div class="col-md-12">
                            <div class="border rounded p-3 bg-white shadow-sm d-flex flex-column justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1 text-primary">@proj.Name</h6>
                                    <p class="small text-secondary mb-3">@proj.Description</p>
                                </div>
                                <div>
                                    <a href="@proj.GitHubLink" target="_blank" class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-github me-1"></i> View Repository
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>